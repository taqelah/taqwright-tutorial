# Copy this file to `.env` (which is gitignored) and fill in your real values.
#   cp .env.example .env
# Get these from BrowserStack → Account & Profile → "Username" and "Access Key".

BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Optional: skip the per-run upload by pointing at a pre-uploaded app id.
# TAQ_APK=bs://<app-id>
