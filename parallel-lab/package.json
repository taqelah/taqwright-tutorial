    "test:single": "taqwright test --project android-single",
    "doctor": "taqwright doctor",
    "devices": "taqwright devices",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "taqwright": "npm:@taqwright/taqwright@^0.1.0-beta.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
