# Copy this file to `.env` (which is gitignored) and fill in your real values.
#   cp .env.example .env
# Get these from BrowserStack → Account & Profile → "Username" and "Access Key".

BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# ⚠️ YOUR OWN APP IDs — needed for the cloud projects.
# The bs://… ids hardcoded in taqwright.config.ts belong to the AUTHOR's BrowserStack account and
# will NOT resolve for yours ("App not found"). Upload the binaries in ../app/ to your account:
#
#   curl -u "$BROWSERSTACK_USERNAME:$BROWSERSTACK_ACCESS_KEY" \
#     -X POST https://api-cloud.browserstack.com/app-automate/upload \
#     -F "file=@../app/DemoApp-v1.0.0.apk"
#
# …then paste the returned "app_url" below. Same again with ../app/DemoApp-v1.1.0-debug-ios.app.zip
# for TAQ_IPA. Don't want to pre-upload? Point these at the local files and taqwright uploads them
# on every run (slower):  TAQ_APK=../app/DemoApp-v1.0.0.apk
# TAQ_APK=bs://<your-android-app-id>
# TAQ_IPA=bs://<your-ios-app-id>
